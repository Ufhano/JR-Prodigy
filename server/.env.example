# Copy to .env and fill in
PORT=5000

# MongoDB: use local OR Atlas
# Local (must have MongoDB running): mongodb://localhost:27017/jr-prodigy
# Atlas: get connection string from https://cloud.mongodb.com → Connect → Driver
MONGO_URI=mongodb://localhost:27017/jr-prodigy

CLIENT_URL=http://localhost:3000

# Auth (Step 4)
JWT_SECRET=your-secret-key-min-32-chars

# Google OAuth (optional): https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web), set Authorized redirect URI to:
#   http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_URL=http://localhost:5000
