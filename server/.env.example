# Copy to .env and fill in
PORT=5000

# MongoDB: use local OR Atlas
# Local (must have MongoDB running): mongodb://localhost:27017/jr-prodigy
# Atlas: get connection string from https://cloud.mongodb.com → Connect → Driver
MONGO_URI=mongodb://localhost:27017/jr-prodigy

CLIENT_URL=http://localhost:3000

# Step 4: add JWT secret
# JWT_SECRET=your-secret-key
